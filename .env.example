# XCEPTA environment variables (copy to .env.local — never commit real values)
#
# Local development should point at the STAGING Supabase project.
# The build/dev server refuses the production project unless you
# explicitly set XCEPTA_ALLOW_PRODUCTION_DB=1 in your shell (not here).
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging anon (public) key>

# Optional — base URL for the local Playwright PDF harness (test-xcepta.cjs)
BASE_URL=http://localhost:5173

# Staging verification script (scripts/staging-verify.mjs) — staging test
# user only; set in your shell or here in .env.local, never in chat.
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
# Optional second staging user on a DIFFERENT tenant (cross-tenant RLS checks)
STAGING_TEST_EMAIL_2=
STAGING_TEST_PASSWORD_2=
